# Copy this file to functions/.env and fill it in.

# The login you create for Mummy's iPhone (Firebase console > Authentication)
MOM_EMAIL=mummy@example.com
# Your login (add brothers/sisters too, comma-separated). Admins get the alerts.
ADMIN_EMAILS=you@example.com

# Firebase console > Project settings > Cloud Messaging > Web Push certificates > Key pair
VAPID_KEY=

# When to ask (24-hour clock, Mummy's time zone)
TIMEZONE=Asia/Kolkata
DOSE_TIMES=09:00,21:00
REMINDER_INTERVAL_MIN=30
# Tell the admins after this many unanswered reminders (4 x 30 min = 2 hours)
ALERT_AFTER_REMINDERS=4
# Give up (and mark "missed") after this many
MAX_REMINDERS=8
# Send a push to admins every time she says "Haan" (true/false)
NOTIFY_ADMIN_ON_TAKEN=true

# Medicine photo
PHOTO_EVERY_DAYS=3
PHOTO_TIME=18:00
GEMINI_MODEL=gemini-flash-latest

# Optional: also send urgent alerts to your WhatsApp via CallMeBot (free).
# See README. Leave empty to use only the admin app notifications.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
